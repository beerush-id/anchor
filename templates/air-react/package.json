{
  "name": "my-air-react",
  "private": true,
  "version": "1.0.0-beta.24",
  "type": "module",
  "description": "AIR Stack for React — Vite SSR Starter",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/worker.ts --outDir dist/server",
    "build": "bun run build:client && bun run build:server",
    "start": "NODE_ENV=production bun dist/server/worker.js",
    "preview": "vite preview --outDir dist/client"
  },
  "dependencies": {
    "@anchorlib/react": "latest",
    "@irpclib/http": "latest",
    "@irpclib/irpc": "latest",
    "@irpclib/ws": "latest",
    "react": "catalog:app",
    "react-dom": "catalog:app"
  },
  "devDependencies": {
    "@anchorlib/vite-ssr": "latest",
    "@biomejs/biome": "2.3.3",
    "@tailwindcss/vite": "4.1.16",
    "@types/bun": "latest",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "tailwindcss": "4.1.16",
    "typescript": "5.9.3",
    "vite": "8.0.10",
    "zod": "4.1.12"
  }
}