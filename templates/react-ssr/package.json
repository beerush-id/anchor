{
  "name": "my-anchor-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "AIR Stack for React — Vite SSR Starter (SSR Only)",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr --outDir dist/server",
    "build": "bun run build:client && bun run build:server",
    "start:bun": "NODE_ENV=production bun server/bun.js",
    "start:node": "NODE_ENV=production node server/node.js",
    "start:deno": "NODE_ENV=production deno run --allow-net --allow-read --allow-env server/deno.js",
    "preview": "vite preview --outDir dist/client"
  },
  "dependencies": {
    "@anchorlib/core": "1.2.24",
    "@anchorlib/react": "1.2.24",
    "@anchorlib/router": "1.2.24",
    "@hono/node-server": "^1.13.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@anchorlib/vite-ssr": "1.2.24",
    "@biomejs/biome": "^2.3.3",
    "@tailwindcss/vite": "^4.1.16",
    "@types/bun": "^1.3.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^8.0.10"
  }
}