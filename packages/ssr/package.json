{
  "type": "module",
  "name": "@anchorlib/ssr",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "directories": {
    "dist": "dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:lib"
  },
  "peerDependencies": {
    "@anchorlib/core": "workspace:*",
    "@anchorlib/router": "workspace:*"
  },
  "optionalDependencies": {
    "@irpclib/http": "workspace:*"
  },
  "scripts": {
    "dev": "rimraf dist && tsdown --watch ./src",
    "clean": "rimraf dist",
    "build": "bun run clean && tsdown && publint",
    "format": "biome format --write",
    "prepublish": "bun run format && bun run build"
  },
  "license": "MIT"
}
