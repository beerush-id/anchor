{
  "name": "create-airlib",
  "version": "2.0.8",
  "description": "Scaffolding tool for AirLib",
  "type": "module",
  "keywords": [
    "airlib",
    "starter",
    "template",
    "scaffold",
    "cli",
    "create-airlib",
    "react",
    "solid",
    "irpc"
  ],
  "author": "Nanang Mahdaen El Agung <mahdaen@gmail.com>",
  "homepage": "https://github.com/beerush-id/airstack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beerush-id/airstack.git"
  },
  "bugs": {
    "url": "https://github.com/beerush-id/airstack/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "create-airlib": "./bin/index.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist && mkdir -p dist",
    "dev": "bun run clean && bun run template && tsdown --watch",
    "build": "bun run clean && bun run template && tsdown",
    "format": "biome format --write",
    "prepublish": "bun run format && bun run build",
    "template": "tar --exclude='.DS_Store' -cf ./dist/templates.tar.tgz -C ../../templates air-react air-solid react-ssr solid-ssr irpc-starter"
  },
  "dependencies": {
    "@clack/prompts": "catalog:lib",
    "commander": "catalog:lib",
    "picocolors": "catalog:lib",
    "tar": "catalog:lib"
  },
  "devDependencies": {
    "@types/node": "catalog:lib",
    "@types/tar": "^6.1.13",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}