{
  "type": "module",
  "name": "@anchorlib/vite-ssr",
  "version": "1.0.0-beta.24",
  "description": "Vite plugin that handles SSR rendering and IRPC routing for AIR Stack applications",
  "keywords": ["vite", "ssr", "anchor", "irpc"],
  "author": "Nanang Mahdaen El Agung <mahdaen@gmail.com>",
  "homepage": "https://github.com/beerush-id/anchor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beerush-id/anchor.git"
  },
  "bugs": {
    "url": "https://github.com/beerush-id/anchor/issues"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "directories": {
    "dist": "./dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@anchorlib/core": "workspace:*",
    "@irpclib/http": "workspace:*",
    "@irpclib/irpc": "workspace:*",
    "@irpclib/ws": "workspace:*",
    "typescript": "catalog:lib",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "@anchorlib/core": {
      "optional": true
    },
    "@irpclib/irpc": {
      "optional": true
    },
    "@irpclib/http": {
      "optional": true
    },
    "@irpclib/ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/ws": "latest",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "ws": "latest"
  },
  "scripts": {
    "dev": "rimraf dist && tsdown --watch ./src",
    "clean": "rimraf dist",
    "build": "rimraf dist && tsdown && publint",
    "prepublish": "rimraf dist && tsdown && publint",
    "format": "biome format --write"
  }
}
