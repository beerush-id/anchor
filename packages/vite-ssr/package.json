{
  "type": "module",
  "name": "@anchorlib/vite-ssr",
  "version": "1.3.0",
  "description": "Vite plugin that handles SSR rendering and IRPC routing for AIR Stack applications",
  "keywords": [
    "vite",
    "ssr",
    "anchor",
    "irpc"
  ],
  "author": "Nanang Mahdaen El Agung <mahdaen@gmail.com>",
  "homepage": "https://github.com/beerush-id/airstack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beerush-id/airstack.git"
  },
  "bugs": {
    "url": "https://github.com/beerush-id/airstack/issues"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js"
    },
    "./ambient": {
      "types": "./dist/ambient.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "directories": {
    "dist": "./dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anchorlib/core": "workspace:*",
    "@irpclib/http": "workspace:*",
    "@irpclib/irpc": "workspace:*",
    "@irpclib/ws": "workspace:*",
    "@mdx-js/mdx": "catalog:lib",
    "@mdx-js/rollup": "catalog:lib",
    "@napi-rs/image": "catalog:lib",
    "acorn": "catalog:lib",
    "acorn-jsx": "catalog:lib",
    "chokidar": "catalog:lib",
    "remark-frontmatter": "catalog:lib",
    "remark-mdx-frontmatter": "catalog:lib",
    "ws": "catalog:lib",
    "yaml": "catalog:lib"
  },
  "peerDependencies": {
    "magic-string": "catalog:lib",
    "vite": "catalog:lib"
  },
  "optionalDependencies": {
    "@vitejs/plugin-react": "catalog:lib"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/mdast": "catalog:lib",
    "@types/ws": "latest",
    "@vitest/coverage-v8": "catalog:",
    "publint": "catalog:",
    "rehype-autolink-headings": "catalog:lib",
    "rehype-pretty-code": "catalog:lib",
    "rehype-slug": "catalog:lib",
    "remark-directive": "catalog:lib",
    "remark-gfm": "catalog:lib",
    "remark-mdx": "catalog:lib",
    "remark-parse": "catalog:lib",
    "remark-rehype": "catalog:lib",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unified": "catalog:lib",
    "vfile": "catalog:lib",
    "vitest": "catalog:"
  },
  "scripts": {
    "dev": "rimraf dist && tsdown --watch ./src",
    "clean": "rimraf dist",
    "build": "bun run clean && tsdown && publint",
    "prepublish": "bun run format && bun run build",
    "format": "biome format --write",
    "test": "rimraf coverage && vitest --run",
    "test:preview": "rimraf coverage && vitest --run && vite preview --outDir coverage"
  }
}