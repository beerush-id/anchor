{
  "type": "module",
  "name": "@anchorlib/vite-ssr",
  "version": "1.2.25",
  "description": "Vite plugin that handles SSR rendering and IRPC routing for AIR Stack applications",
  "keywords": [
    "vite",
    "ssr",
    "anchor",
    "irpc"
  ],
  "author": "Nanang Mahdaen El Agung <mahdaen@gmail.com>",
  "homepage": "https://github.com/beerush-id/airstack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beerush-id/airstack.git"
  },
  "bugs": {
    "url": "https://github.com/beerush-id/airstack/issues"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js"
    },
    "./ambient": {
      "types": "./dist/ambient.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "directories": {
    "dist": "./dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anchorlib/core": "workspace:*",
    "@irpclib/http": "workspace:*",
    "@irpclib/irpc": "workspace:*",
    "@irpclib/ws": "workspace:*",
    "@napi-rs/image": "catalog:lib",
    "vite": "catalog:lib",
    "ws": "catalog:lib"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/ws": "latest",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "dev": "rimraf dist && tsdown --watch ./src",
    "clean": "rimraf dist",
    "build": "bun run clean && tsdown && publint",
    "prepublish": "bun run format && bun run build",
    "format": "biome format --write"
  }
}